# App Server Configuration
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"
JWT_SECRET="YOUR_JWT_SECRET_KEY"

# Supabase Configuration (PostgreSQL Database, Auth & Storage)
# Required for production Supabase connection. When not set, the app runs on the isolated local database adapter with full schema and RLS emulation.
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_PUBLIC_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_SECRET_KEY"

# Payment Gateway Configuration (UPI, Cards, Netbanking)
# Isolated adapter provides interactive sandbox simulator with QR generation & webhook callbacks.
PAYMENT_GATEWAY_KEY_ID="rzp_test_YOUR_KEY_ID"
PAYMENT_GATEWAY_KEY_SECRET="YOUR_GATEWAY_SECRET"
PAYMENT_WEBHOOK_SECRET="YOUR_WEBHOOK_SIGNATURE_SECRET"

# Logistics / Courier Integration (Delhivery / Shiprocket / BlueDart)
LOGISTICS_API_KEY="YOUR_LOGISTICS_API_KEY"
